<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, shrink-to-fit=no, viewport-fit=cover">
    
    <!-- iOS / PWA Specific Meta Tags -->
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="PeteDF Reader">
    <link rel="apple-touch-icon" href="https://img.icons8.com/color/512/book-open.png">
    
    <!-- Dynamic Manifest Injection for PWA compatibility -->
    <link rel="manifest" id="pwa-manifest">

    <title>PeteDF Reader - Professional PDF Markup Engine</title>
    
    <!-- Tailwind CSS & Lucide Icons -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest"></script>
    <!-- PDF.js -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.4.120/pdf.min.js"></script>

    <style>
        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            -webkit-font-smoothing: antialiased;
            user-select: none;
            -webkit-user-select: none;
        }
        
        html, body {
            position: fixed;
            overflow: hidden;
            width: 100%;
            height: 100%;
        }

        #pdf-canvas, #annotation-canvas {
            position: absolute;
            top: 0;
            left: 0;
            touch-action: none; 
        }

        .canvas-container {
            position: relative;
            box-shadow: 0 20px 25px -5px rgb(0 0 0 / 0.1), 0 8px 10px -6px rgb(0 0 0 / 0.1);
            border-radius: 12px;
            overflow: hidden;
            background: #ffffff;
        }

        /* Apple Safari Smooth Blurs & Animation */
        .ios-prompt-anim {
            animation: slideUp 0.4s cubic-bezier(0.16, 1, 0.3, 1);
        }

        @keyframes slideUp {
            from { transform: translateY(100%); opacity: 0; }
            to { transform: translateY(0); opacity: 1; }
        }
    </style>
</head>
<body class="bg-[#f2f2f7] text-slate-900 h-screen flex flex-col overflow-hidden transition-colors duration-200">

    <!-- Header Navigation -->
    <header class="bg-white/80 backdrop-blur-md border-b border-slate-200/80 px-4 py-3 flex items-center justify-between shadow-sm z-10 sticky top-0">
        <div class="flex items-center space-x-3">
            <div class="bg-indigo-600 text-white p-2.5 rounded-xl shadow-md">
                <i data-lucide="book-open" class="w-5 h-5"></i>
            </div>
            <div>
                <h1 class="text-md font-bold text-slate-900 leading-tight">PeteDF <span class="text-[10px] bg-indigo-100 text-indigo-700 px-2 py-0.5 rounded-full font-bold ml-1">Reader</span></h1>
                <p class="text-[11px] text-slate-500 font-semibold truncate max-w-[150px] sm:max-w-xs" id="file-name-display">No File Loaded</p>
            </div>
        </div>

        <div class="flex items-center space-x-2">
            <!-- Paging -->
            <div class="flex items-center bg-slate-100/80 rounded-xl p-0.5 space-x-1 border border-slate-200/50">
                <button id="prev-page" class="p-2 rounded-lg hover:bg-white text-slate-600"><i data-lucide="chevron-left" class="w-4 h-4"></i></button>
                <div class="flex items-center px-1 text-xs font-bold text-slate-700">
                    <input type="number" id="page-num" value="1" min="1" class="w-9 text-center bg-transparent focus:outline-none">
                    <span class="mx-0.5 text-slate-400">/</span>
                    <span id="page-count">0</span>
                </div>
                <button id="next-page" class="p-2 rounded-lg hover:bg-white text-slate-600"><i data-lucide="chevron-right" class="w-4 h-4"></i></button>
            </div>

            <!-- Zoom -->
            <div class="flex items-center bg-slate-100/80 rounded-xl p-0.5 space-x-1 border border-slate-200/50">
                <button id="zoom-out" class="p-2 rounded-lg hover:bg-white text-slate-600"><i data-lucide="zoom-out" class="w-4 h-4"></i></button>
                <span id="zoom-percent" class="text-[11px] font-bold px-1.5 text-slate-700 w-12 text-center">100%</span>
                <button id="zoom-in" class="p-2 rounded-lg hover:bg-white text-slate-600"><i data-lucide="zoom-in" class="w-4 h-4"></i></button>
                <button id="zoom-fit" class="p-2 rounded-lg hover:bg-white text-slate-600"><i data-lucide="maximize" class="w-4 h-4"></i></button>
            </div>
        </div>

        <div class="flex items-center space-x-2">
            <button id="install-btn" class="hidden bg-emerald-600 hover:bg-emerald-700 text-white px-3.5 py-2 rounded-xl text-xs font-bold shadow-md flex items-center space-x-1">
                <i data-lucide="download" class="w-4 h-4"></i>
                <span>Install</span>
            </button>
            <label class="cursor-pointer bg-indigo-600 hover:bg-indigo-700 text-white px-3.5 py-2 rounded-xl text-xs font-bold shadow-md flex items-center space-x-1.5">
                <i data-lucide="plus" class="w-4 h-4"></i>
                <span class="hidden sm:inline">Import PDF</span>
                <input type="file" id="file-picker" accept="application/pdf" class="hidden">
            </label>
        </div>
    </header>

    <!-- Main View Window -->
    <div class="flex-1 flex overflow-hidden">
        
        <!-- Native-look Left Sidebar with Toggle-able Views (Thumbnails vs ToC Outline) -->
        <aside class="w-64 bg-white border-r border-slate-200 flex flex-col hidden md:flex transition-all" id="left-sidebar">
            <div class="p-3 border-b border-slate-100 bg-slate-50/50 flex space-x-1">
                <!-- Segmented Control Button (Apple Design Style) -->
                <button id="show-thumbnails" class="flex-1 py-1.5 text-[11px] font-bold rounded-lg bg-white text-indigo-600 shadow-sm border border-slate-200/80 transition-all">
                    Thumbnails
                </button>
                <button id="show-outline" class="flex-1 py-1.5 text-[11px] font-bold rounded-lg text-slate-500 hover:bg-white/50 transition-all">
                    Outline (ToC)
                </button>
            </div>

            <!-- Page Thumbnails Container -->
            <div class="flex-1 overflow-y-auto p-3 space-y-3" id="thumbnail-container">
                <div class="text-center text-slate-400 text-xs py-12">
                    <i data-lucide="file-text" class="w-10 h-12 mx-auto mb-2 opacity-40"></i>
                    <p>Load a PDF to preview pages</p>
                </div>
            </div>

            <!-- Table of Contents Outline Container -->
            <div class="flex-1 overflow-y-auto p-4 space-y-2 hidden" id="outline-container">
                <div class="text-center text-slate-400 text-xs py-12">
                    <i data-lucide="list-tree" class="w-10 h-12 mx-auto mb-2 opacity-40"></i>
                    <p>Outline structure is currently empty</p>
                </div>
            </div>
        </aside>

        <main class="flex-1 bg-[#eaeaf0] overflow-auto flex justify-center items-start p-4 sm:p-8 relative" id="viewer-container">
            <div id="pdf-wrapper" class="canvas-container hidden">
                <canvas id="pdf-canvas"></canvas>
                <canvas id="annotation-canvas" class="cursor-crosshair"></canvas>
            </div>
            
            <div id="dropzone" class="m-auto border border-dashed border-slate-300 hover:border-indigo-500 bg-white rounded-2xl p-8 sm:p-12 text-center max-w-sm cursor-pointer shadow-xl">
                <div class="bg-indigo-50 w-16 h-16 rounded-full flex items-center justify-center mx-auto mb-4">
                    <i data-lucide="file-up" class="w-8 h-8 text-indigo-600"></i>
                </div>
                <h3 class="text-md font-bold text-slate-900 mb-1">Open in PeteDF Reader</h3>
                <p class="text-xs text-slate-400 mb-6">Select a file from your iOS, iPadOS, macOS, or iCloud system</p>
                <span class="bg-indigo-600 hover:bg-indigo-700 text-white px-4 py-2.5 rounded-xl text-xs font-semibold shadow-md">Select Document</span>
            </div>
        </main>

        <!-- Right Markup Toolbar -->
        <aside class="w-16 bg-white border-l border-slate-200 flex flex-col items-center py-4 space-y-4 shadow-sm z-10">
            <span class="text-[9px] font-bold text-slate-400 uppercase tracking-wider">Markup</span>
            <div class="flex flex-col space-y-2 w-full px-2">
                <button id="tool-pan" class="tool-btn p-2.5 rounded-xl bg-slate-100 text-indigo-600 flex justify-center"><i data-lucide="mouse-pointer" class="w-5 h-5"></i></button>
                <button id="tool-draw" class="tool-btn p-2.5 rounded-xl hover:bg-slate-100 text-slate-600 flex justify-center"><i data-lucide="pen-tool" class="w-5 h-5"></i></button>
                <button id="tool-text" class="tool-btn p-2.5 rounded-xl hover:bg-slate-100 text-slate-600 flex justify-center"><i data-lucide="sticky-note" class="w-5 h-5"></i></button>
                <button id="tool-clear" class="p-2.5 rounded-xl hover:bg-rose-50 text-rose-500 flex justify-center"><i data-lucide="trash-2" class="w-5 h-5"></i></button>
            </div>
            <hr class="w-8 border-slate-100">
            <div class="flex flex-col space-y-2.5" id="color-selectors">
                <button class="color-btn w-5 h-5 rounded-full bg-[#ff3b30] ring-2 ring-offset-2 ring-[#ff3b30]" data-color="#ff3b30"></button>
                <button class="color-btn w-5 h-5 rounded-full bg-[#007aff] ring-2 ring-offset-2 ring-transparent hover:ring-[#007aff]" data-color="#007aff"></button>
                <button class="color-btn w-5 h-5 rounded-full bg-[#34c759] ring-2 ring-offset-2 ring-transparent hover:ring-[#34c759]" data-color="#34c759"></button>
                <button class="color-btn w-5 h-5 rounded-full bg-[#ffcc00] ring-2 ring-offset-2 ring-transparent hover:ring-[#ffcc00]" data-color="#ffcc00"></button>
            </div>
            <div class="flex flex-col items-center space-y-1 w-full px-2 pt-2">
                <span class="text-[8px] font-bold text-slate-400">Weight</span>
                <input type="range" id="stroke-width" min="1" max="15" value="3" class="w-full h-1 bg-slate-200 rounded-lg appearance-none cursor-pointer accent-indigo-600">
            </div>
        </aside>
    </div>

    <!-- iOS "ADD TO HOME SCREEN" POPUP PROMPT -->
    <div id="ios-install-prompt" class="hidden fixed bottom-6 left-1/2 -translate-x-1/2 w-[92%] max-w-sm bg-white/95 backdrop-blur-lg border border-slate-200/80 rounded-2xl p-4 shadow-2xl z-50 ios-prompt-anim">
        <div class="flex items-start justify-between">
            <div class="flex space-x-3">
                <img src="https://img.icons8.com/color/512/book-open.png" class="w-12 h-12 rounded-xl shadow-md border border-slate-100">
                <div>
                    <h4 class="text-sm font-bold text-slate-900">Install PeteDF Reader</h4>
                    <p class="text-xs text-slate-500">Add to your Home Screen for full screen off-line access.</p>
                </div>
            </div>
            <button id="close-prompt" class="text-slate-400 hover:text-slate-600">
                <i data-lucide="x" class="w-5 h-5"></i>
            </button>
        </div>
        <div class="mt-4 pt-3 border-t border-slate-100 flex items-center justify-center space-x-2 text-xs font-semibold text-slate-700">
            <span>Tap</span>
            <div class="p-1 bg-slate-100 rounded border border-slate-200">
                <i data-lucide="share-2" class="w-4 h-4 text-indigo-600"></i>
            </div>
            <span>then select</span>
            <span class="text-indigo-600 font-bold">"Add to Home Screen"</span>
        </div>
    </div>

    <script>
        lucide.createIcons();
        pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.4.120/pdf.worker.min.js';

        // Dynamic Manifest Generation configured for "PeteDF Reader"
        const manifestObj = {
            "short_name": "PeteDF",
            "name": "PeteDF Reader",
            "icons": [
                { "src": "https://img.icons8.com/color/512/book-open.png", "sizes": "512x512", "type": "image/png" }
            ],
            "start_url": window.location.href,
            "background_color": "#f2f2f7",
            "theme_color": "#6366f1",
            "display": "standalone",
            "orientation": "portrait"
        };
        const manifestBlob = new Blob([JSON.stringify(manifestObj)], {type: 'application/json'});
        document.getElementById('pwa-manifest').setAttribute('href', URL.createObjectURL(manifestBlob));

        // State Variables
        let pdfDoc = null, pageNum = 1, pageRendering = false, pageNumPending = null, scale = 1.25;
        let canvas = document.getElementById('pdf-canvas'), ctx = canvas.getContext('2d');
        let annCanvas = document.getElementById('annotation-canvas'), annCtx = annCanvas.getContext('2d');
        let currentTool = 'pan', selectedColor = '#ff3b30', strokeWidth = 3, isDrawing = false, drawingHistory = {};

        // DOM Setup
        const filePicker = document.getElementById('file-picker'), dropzone = document.getElementById('dropzone'), pdfWrapper = document.getElementById('pdf-wrapper');
        const pageNumInput = document.getElementById('page-num'), pageCountSpan = document.getElementById('page-count'), zoomPercentSpan = document.getElementById('zoom-percent');
        const fileNameDisplay = document.getElementById('file-name-display');
        
        // Sidebar Toggle States
        const showThumbnailsBtn = document.getElementById('show-thumbnails');
        const showOutlineBtn = document.getElementById('show-outline');
        const thumbnailContainer = document.getElementById('thumbnail-container');
        const outlineContainer = document.getElementById('outline-container');

        // Toggle Sidebar Views Action
        showThumbnailsBtn.addEventListener('click', () => {
            showThumbnailsBtn.className = "flex-1 py-1.5 text-[11px] font-bold rounded-lg bg-white text-indigo-600 shadow-sm border border-slate-200/80 transition-all";
            showOutlineBtn.className = "flex-1 py-1.5 text-[11px] font-bold rounded-lg text-slate-500 hover:bg-white/50 transition-all";
            thumbnailContainer.classList.remove('hidden');
            outlineContainer.classList.add('hidden');
        });

        showOutlineBtn.addEventListener('click', () => {
            showOutlineBtn.className = "flex-1 py-1.5 text-[11px] font-bold rounded-lg bg-white text-indigo-600 shadow-sm border border-slate-200/80 transition-all";
            showThumbnailsBtn.className = "flex-1 py-1.5 text-[11px] font-b
